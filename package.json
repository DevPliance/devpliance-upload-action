{
  "name": "devpliance-upload-action",
  "version": "0.1.0",
  "description": "Monorepo: the devpliance CLI plus the GitHub Action that uploads .devpliance evidence",
  "main": "dist/index.js",
  "private": true,
  "workspaces": [
    "cli"
  ],
  "scripts": {
    "build:cli": "npm run build --workspace devpliance",
    "build:action": "ncc build src/main.ts -o dist --license licenses.txt",
    "build": "npm run build:cli && npm run build:action",
    "typecheck": "npm run build:cli && tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "devpliance": "*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vercel/ncc": "^0.38.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
