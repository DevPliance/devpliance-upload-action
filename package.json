{
  "name": "devpliance-upload-action",
  "version": "2.0.0",
  "description": "Monorepo: the devpliance CLI plus the GitHub Action for retained repository evidence reviews",
  "main": "dist/index.js",
  "private": true,
  "workspaces": [
    "cli"
  ],
  "scripts": {
    "build:cli": "npm run build --workspace devpliance",
    "build:action": "ncc build src/index.js -o dist --minify --license licenses.txt",
    "build": "npm run build:cli && npm run build:action",
    "typecheck": "npm run build:cli",
    "test": "vitest run"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "adm-zip": "^0.6.0",
    "devpliance": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vercel/ncc": "^0.38.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "undici": "^6.28.1"
  }
}
